---
layout: base.njk
pagination:
  data: lessons
  size: 1
  alias: lesson
permalink: "/lectio/{{ lesson.meta.lesson }}/"
eleventyComputed:
  title: "{{ lesson.meta.title }}"
---
{#- One Latin/English pair: two grid items that land in the same row. -#}
{%- macro row(r) -%}
{%- if r.kind == "heading" %}
<h3 lang="la">{{ r.la.text | la(r.la.accented) | safe }}</h3>
<h3 lang="en">{{ r.en | safe }}</h3>
{%- elif r.kind == "source" %}
<p lang="la"><cite>{{ r.la.text | la(r.la.accented) | safe }}</cite></p>
<p lang="en"><cite>{{ r.en | safe }}</cite></p>
{%- else %}
<p lang="la" class="sentence" data-n="{{ r.n }}"><span>{{ r.la.text | la(r.la.accented) | safe }}</span></p>
<p lang="en" class="sentence" data-n="{{ r.n }}"><span>{{ r.en | safe }}</span></p>
{%- endif %}
{%- endmacro -%}

<article>
<h1>{{ lesson.meta.title }}</h1>

{%- if lesson.latin.length or lesson.english.length %}
<div class="parallel">
{%- if lesson.meta.subtitle.latin or lesson.meta.subtitle.english %}
<h2 lang="la">{{ lesson.meta.subtitle.latin | la(lesson.meta.subtitle.latinAccented) | safe }}</h2>
<h2 lang="en">{{ lesson.meta.subtitle.english | safe }}</h2>
{%- endif %}
{%- for r in lesson | rows({ headings: lesson.headings, sources: lesson.sources }) %}{{ row(r) }}{% endfor %}
</div>
{%- endif %}

{%- if lesson.notes.footnotes.length or lesson.notes.comments.length %}
<section lang="en">
<h2>{% if lesson.meta.revision %}Revision and Notes{% else %}Notes{% endif %}</h2>
{%- if lesson.notes.footnotes.length %}
<ol>
  {%- for note in lesson.notes.footnotes %}
  <li>{{ note | paras | safe }}</li>
  {%- endfor %}
</ol>
{%- endif %}
{%- for comment in lesson.notes.comments %}
{{ comment | paras | safe }}
{%- endfor %}
</section>
{%- endif %}

{%- if lesson.song %}
<section>
<h2>{{ lesson.song.kind }}</h2>
{%- if lesson.song.title.latin %}<h3 lang="la">{{ lesson.song.title.latin | la(lesson.song.title.latinAccented) | safe }}</h3>{% endif %}
<p lang="la">
  {%- for line in lesson.song.latin %}{{ line | la(lesson.song.latinAccented[loop.index0]) | safe }}{% if not loop.last %}<br>{% endif %}{% endfor -%}
</p>
{%- if lesson.song.title.english %}<h3 lang="en">{{ lesson.song.title.english }}</h3>{% endif %}
<p lang="en">{{ lesson.song.english | join("<br>") | safe }}</p>
{%- if lesson.song.source %}<p><cite>{{ lesson.song.source }}</cite></p>{% endif %}
</section>
{%- endif %}

{%- if lesson.exercises.latin.length %}
<section>
<h2 lang="la">Exercitatio</h2>
<div class="parallel">
{%- for r in lesson.exercises | rows %}{{ row(r) }}{% endfor %}
</div>
{%- if lesson.exercises.footnotes.length %}
<ol>
  {%- for note in lesson.exercises.footnotes %}
  <li>{{ note | paras | safe }}</li>
  {%- endfor %}
</ol>
{%- endif %}
</section>
{%- endif %}
</article>

<nav>
{%- if pagination.href.previous %}<a href="{{ pagination.href.previous }}">← {{ lessons[pagination.pageNumber - 1].meta.title }}</a>{% endif %}
{%- if pagination.href.previous and pagination.href.next %} · {% endif %}
{%- if pagination.href.next %}<a href="{{ pagination.href.next }}">{{ lessons[pagination.pageNumber + 1].meta.title }} →</a>{% endif %}
</nav>
