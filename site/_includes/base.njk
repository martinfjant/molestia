<!doctype html>
<html lang="la">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex, nofollow">
  <link
        rel="stylesheet"
        href="https://cdn.jsdelivr.net/npm/@picocss/pico@2/css/pico.classless.red.min.css"
      >
  <title>{{ title }} · Sine Molestia</title>
  <style>
    /* Latin and English as facing columns, each sentence level with its
       translation. The items alternate Latin/English in one grid; pinning each
       language to its own column puts every pair in the same row. */
    article { container-type: inline-size; }
    .parallel {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.5rem 2rem;
    }
    .parallel > * { margin: 0; }
    .parallel > [lang="la"] { grid-column: 1; }
    .parallel > [lang="en"] { grid-column: 2; }
    .parallel > h3 { margin-top: 1rem; }
    .parallel .sentence { display: flex; gap: 0em; }
    .parallel .sentence::before { content: attr(data-n) "."; flex: none; min-width: 2.5ch; text-align: left; }
    /* Songs: each column only as wide as its lines, the pair centred. :where keeps
       this as weak as .parallel, so the one-column rules below still win. */
    .parallel:where(.song) {
      grid-template-columns: repeat(2, fit-content(calc(50% - 2rem)));
      justify-content: center;
      column-gap: 4rem;
    }
    .song > div { justify-self: center; }

    .table-scroll { overflow-x: auto; }

    /* "Hide English": Latin alone, full width, in lessons and exercises. */
    body:has(#english-toggle:checked) .parallel { grid-template-columns: 1fr; }
    body:has(#english-toggle:checked) .parallel > [lang="en"] { display: none; }

    /* "Hide notes": the notes, the exercise footnotes and the note numbers. */
    body:has(#notes-toggle:checked) :is(.notes, .parallel sup) { display: none; }
    [lang="en"] {
    hyphens: auto;
    }
    p {
    text-wrap: pretty;
    }
    .notes {
    column-count: 2;
    orphans: 2;
    widows: 2;
    }
    ol {
    padding: 0.5em}
    /* Too narrow for two ~20rem columns: one column, all Latin then all English. */
    @container (width < 42rem) {
      .parallel { grid-template-columns: 1fr; }
      .parallel > [lang="en"] { grid-column: 1; order: 1; }
      .parallel > [lang="en"]:first-of-type { margin-top: 1.5rem; }
      .notes {
    column-count: 1
    }
    }
    body {
        font-family: system-ui;
    }
  </style>
</head>
<body>
  <header>
  <nav>
      <ul>
    <li><a href="/" role="button">Latine Sine Molestia</a>
      </ul>
      <ul>
    <li><label><input type="checkbox" id="accent-toggle"> Show stress accents</label>
    <li><label><input type="checkbox" id="english-toggle"> Hide English</label>
    <li><label><input type="checkbox" id="notes-toggle"> Hide notes</label>
      </ul>
    </nav>
  </header>
  <main>
{{ content | safe }}
  </main>
  <script>
    // A header checkbox whose state is remembered across pages.
    const remember = (id, key, apply = () => {}) => {
      const toggle = document.getElementById(id);
      try { toggle.checked = localStorage.getItem(key) === "on"; } catch {}
      apply(toggle.checked);
      toggle.addEventListener("change", () => {
        apply(toggle.checked);
        try { localStorage.setItem(key, toggle.checked ? "on" : "off"); } catch {}
      });
    };
    // Swap each Latin text for its stress-accented twin.
    remember("accent-toggle", "accents", (on) => {
      document.querySelectorAll("[data-plain]").forEach((el) => (el.hidden = on));
      document.querySelectorAll("[data-accented]").forEach((el) => (el.hidden = !on));
    });
    // Hiding English and notes is done in CSS, off the checkboxes themselves.
    remember("english-toggle", "english-hidden");
    remember("notes-toggle", "notes-hidden");
  </script>
</body>
</html>
