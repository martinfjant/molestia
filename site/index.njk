---
layout: base.njk
title: Lectiones
---
<article>
<h1>Lectiones</h1>
<ol style="column-count: 2">
{%- for lesson in lessons %}
  <li value="{{ lesson.meta.lesson }}"><a href="/lectio/{{ lesson.meta.lesson }}/">{{ lesson.meta.title }}</a>
    {%- if lesson.meta.subtitle.latin %} — {{ lesson.meta.subtitle.latin | safe }}{% endif %}
    {%- if lesson.meta.revision %} (revisio){% endif %}</li>
{%- endfor %}
</ol>
</article>
